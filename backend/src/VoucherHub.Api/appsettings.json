{
  "Registration": {
    "VerificationTokenLifetimeMinutes": 15,
    "PendingRegistrationRetentionHours": 24,
    "ResendCooldownSeconds": 60,
    "VerificationPageUrl": "http://localhost:5173/verify-email"
  },
  "Jwt": {
    "Issuer": "VoucherHub",
    "Audience": "VoucherHub.Client",
    "AccessTokenLifetimeMinutes": 15
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "Username": null,
    "Password": null,
    "FromEmail": "no-reply@voucherhub.local",
    "FromName": "VoucherHub"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "RateLimits": {
    "RegistrationPerMinute": 10,
    "LoginPerMinute": 5,
    "RedeemPerMinute": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
